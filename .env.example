# Copia questo file in ".env" e riempi i valori.
# NON condividere la SERVICE_KEY con nessuno e non metterla nel frontend.

SUPABASE_URL=https://xrnujmdrtiliiqhntkwj.supabase.co

# Chiave *secret* / service_role (Supabase → Settings → API Keys → Secret keys).
# Inizia con "sb_secret_..." (oppure la vecchia "service_role").
SUPABASE_SERVICE_KEY=INCOLLA_QUI_LA_SECRET_KEY

# Dove salvare l'Excel. Se metti una cartella dentro il Google Drive del tuo Mac,
# finisce su Drive da solo. Esempio:
# OUTPUT_DIR=/percorso/della/cartella
OUTPUT_DIR=.
